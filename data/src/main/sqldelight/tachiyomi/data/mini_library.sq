CREATE TABLE mini_library(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL UNIQUE,
    source_id INTEGER NOT NULL,
    date_added INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(manga_id) REFERENCES mangas(_id)
    ON DELETE CASCADE
);

CREATE INDEX idx_mini_library_source ON mini_library(source_id);
CREATE INDEX idx_mini_library_manga ON mini_library(manga_id);

getMiniLibraryBySource:
SELECT
    ml._id,
    ml.manga_id,
    ml.source_id,
    ml.date_added,
    m.url,
    m.title,
    m.thumbnail_url,
    m.status
FROM mini_library ml
JOIN mangas m ON ml.manga_id = m._id
WHERE ml.source_id = :sourceId
ORDER BY ml.date_added DESC;

isMiniLibraryManga:
SELECT count(*) FROM mini_library WHERE manga_id = :mangaId;

insertMiniLibrary:
INSERT OR IGNORE INTO mini_library(manga_id, source_id) VALUES (:mangaId, :sourceId);

deleteMiniLibraryManga:
DELETE FROM mini_library WHERE manga_id = :mangaId;

getMiniLibraryCount:
SELECT count(*) FROM mini_library WHERE source_id = :sourceId;
