import kotlin.collections.List;
import kotlin.String;

CREATE TABLE manga_external_metadata (
    manga_id INTEGER NOT NULL PRIMARY KEY,
    score REAL,
    status TEXT,
    start_date TEXT,
    total_chapters INTEGER,
    genres TEXT AS List<String>,
    tags TEXT AS List<String>,
    licensor TEXT,
    demographic TEXT,
    synopsis TEXT,
    source_name TEXT NOT NULL,
    fetched_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id) ON DELETE CASCADE
);

selectByMangaId:
SELECT *
FROM manga_external_metadata
WHERE manga_id = :mangaId;

selectAll:
SELECT *
FROM manga_external_metadata;

upsert:
INSERT INTO manga_external_metadata(
    manga_id,
    score,
    status,
    start_date,
    total_chapters,
    genres,
    tags,
    licensor,
    demographic,
    synopsis,
    source_name,
    fetched_at
)
VALUES (
    :mangaId,
    :score,
    :status,
    :startDate,
    :totalChapters,
    :genres,
    :tags,
    :licensor,
    :demographic,
    :synopsis,
    :sourceName,
    :fetchedAt
)
ON CONFLICT(manga_id)
DO UPDATE
SET
    score = :score,
    status = :status,
    start_date = :startDate,
    total_chapters = :totalChapters,
    genres = :genres,
    tags = :tags,
    licensor = :licensor,
    demographic = :demographic,
    synopsis = :synopsis,
    source_name = :sourceName,
    fetched_at = :fetchedAt
WHERE manga_id = :mangaId;

deleteByMangaId:
DELETE FROM manga_external_metadata
WHERE manga_id = :mangaId;
