CREATE TABLE suggestions(
    manga_id INTEGER NOT NULL PRIMARY KEY REFERENCES mangas(_id) ON DELETE CASCADE,
    relevance REAL NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE INDEX idx_suggestions_relevance ON suggestions(relevance);

CREATE TABLE suggestion_tags (
    tag TEXT NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL DEFAULT 0,
    is_blocked INTEGER NOT NULL DEFAULT 0,
    is_user_added INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE suggestion_sources (
    source_id INTEGER NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL DEFAULT 0,
    is_blocked INTEGER NOT NULL DEFAULT 0,
    is_user_added INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE suggestion_authors (
    author TEXT NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL DEFAULT 0,
    is_blocked INTEGER NOT NULL DEFAULT 0,
    is_user_added INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE suggestion_artists (
    artist TEXT NOT NULL PRIMARY KEY,
    count INTEGER NOT NULL DEFAULT 0,
    is_blocked INTEGER NOT NULL DEFAULT 0,
    is_user_added INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE suggestion_dismissed (
    manga_url TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

getSuggestions:
SELECT
    mangas.*,
    suggestions.relevance,
    suggestions.created_at
FROM suggestions
JOIN mangas ON suggestions.manga_id = mangas._id
ORDER BY suggestions.relevance DESC;

countSuggestions:
SELECT COUNT(*)
FROM suggestions;

deleteAllSuggestions:
DELETE FROM suggestions;

insertSuggestion:
INSERT OR REPLACE INTO suggestions(manga_id, relevance, created_at)
VALUES (:mangaId, :relevance, :createdAt);

updateSuggestion:
UPDATE suggestions
SET relevance = :relevance, created_at = :createdAt
WHERE manga_id = :mangaId;

deleteSuggestion:
DELETE FROM suggestions
WHERE manga_id = :mangaId;

-- Tag queries
getSuggestionTags:
SELECT * FROM suggestion_tags ORDER BY sort_order ASC, count DESC;

insertSuggestionTag:
INSERT OR REPLACE INTO suggestion_tags(tag, count, is_blocked, is_user_added, sort_order)
VALUES (:tag, :count, :isBlocked, :isUserAdded, :sortOrder);

updateSuggestionTag:
UPDATE suggestion_tags
SET count = :count, is_blocked = :isBlocked, is_user_added = :isUserAdded, sort_order = :sortOrder
WHERE tag = :tag;

deleteSuggestionTag:
DELETE FROM suggestion_tags WHERE tag = :tag;

deleteAllSuggestionTags:
DELETE FROM suggestion_tags;

-- Source/Extension queries
getSuggestionSources:
SELECT * FROM suggestion_sources ORDER BY sort_order ASC, count DESC;

insertSuggestionSource:
INSERT OR REPLACE INTO suggestion_sources(source_id, count, is_blocked, is_user_added, sort_order)
VALUES (:sourceId, :count, :isBlocked, :isUserAdded, :sortOrder);

updateSuggestionSource:
UPDATE suggestion_sources
SET count = :count, is_blocked = :isBlocked, is_user_added = :isUserAdded, sort_order = :sortOrder
WHERE source_id = :sourceId;

deleteSuggestionSource:
DELETE FROM suggestion_sources WHERE source_id = :sourceId;

deleteAllSuggestionSources:
DELETE FROM suggestion_sources;

-- Dismissed queries
getDismissedSuggestions:
SELECT * FROM suggestion_dismissed;

insertDismissedSuggestion:
INSERT OR REPLACE INTO suggestion_dismissed(manga_url, title, created_at)
VALUES (:mangaUrl, :title, :createdAt);

deleteDismissedSuggestion:
DELETE FROM suggestion_dismissed WHERE manga_url = :mangaUrl;

deleteAllDismissedSuggestions:
DELETE FROM suggestion_dismissed;

-- Author queries
getSuggestionAuthors:
SELECT * FROM suggestion_authors ORDER BY sort_order ASC, count DESC;

insertSuggestionAuthor:
INSERT OR REPLACE INTO suggestion_authors(author, count, is_blocked, is_user_added, sort_order)
VALUES (:author, :count, :isBlocked, :isUserAdded, :sortOrder);

updateSuggestionAuthor:
UPDATE suggestion_authors
SET count = :count, is_blocked = :isBlocked, is_user_added = :isUserAdded, sort_order = :sortOrder
WHERE author = :author;

deleteSuggestionAuthor:
DELETE FROM suggestion_authors WHERE author = :author;

deleteAllSuggestionAuthors:
DELETE FROM suggestion_authors;

-- Artist queries
getSuggestionArtists:
SELECT * FROM suggestion_artists ORDER BY sort_order ASC, count DESC;

insertSuggestionArtist:
INSERT OR REPLACE INTO suggestion_artists(artist, count, is_blocked, is_user_added, sort_order)
VALUES (:artist, :count, :isBlocked, :isUserAdded, :sortOrder);

updateSuggestionArtist:
UPDATE suggestion_artists
SET count = :count, is_blocked = :isBlocked, is_user_added = :isUserAdded, sort_order = :sortOrder
WHERE artist = :artist;

deleteSuggestionArtist:
DELETE FROM suggestion_artists WHERE artist = :artist;

deleteAllSuggestionArtists:
DELETE FROM suggestion_artists;


