CREATE TABLE granular_scoring_entry (
    manga_id INTEGER NOT NULL PRIMARY KEY,
    template_name TEXT NOT NULL,
    criteria_json TEXT NOT NULL,
    total_score REAL NOT NULL,
    scale_10_score REAL NOT NULL,
    ignore_unrated INTEGER NOT NULL DEFAULT 1,
    auto_sync_tracker INTEGER NOT NULL DEFAULT 1,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id) ON DELETE CASCADE
);

CREATE TABLE granular_scoring_template (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    media_type TEXT NOT NULL,
    criteria_json TEXT NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0
);
